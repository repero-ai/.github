{
  "name": "Organization - Critical projects",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "repository_property": {
      "include": [
        {
          "name": "security-tier",
          "property_values": [
            "critical"
          ],
          "source": "custom"
        }
      ],
      "exclude": []
    },
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "do_not_enforce_on_create": true,
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          {
            "context": "required-ci"
          }
        ]
      }
    }
  ]
}
