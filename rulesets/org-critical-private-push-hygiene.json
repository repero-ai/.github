{
  "name": "Organization - Critical private repository push hygiene",
  "target": "push",
  "enforcement": "active",
  "conditions": {
    "repository_name": {
      "include": [
        "ai-platform",
        "billing-core",
        "ai-platform-ops"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "file_path_restriction",
      "parameters": {
        "restricted_file_paths": [
          "**/.env",
          "**/.env.local",
          "**/.env.prod",
          "**/.env.production",
          "**/.env.secrets",
          "**/id_rsa",
          "**/id_ed25519",
          "**/*.key",
          "**/*.p12",
          "**/*.pfx",
          "**/*.sqlite",
          "**/*.sqlite3",
          "**/*.dump"
        ]
      }
    },
    {
      "type": "max_file_size",
      "parameters": {
        "max_file_size": 20
      }
    }
  ]
}
